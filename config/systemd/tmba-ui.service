[Unit]
Description=TMBA Native Touch UI
After=systemd-user-sessions.service tmba-backend.service
Requires=tmba-backend.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=root

TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal

TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

Environment=HOME=/root
Environment=DISPLAY=:0
Environment=QT_QPA_PLATFORM=xcb

ExecStart=/usr/bin/xinit /opt/tmba/ui/start-tmba-ui.sh -- /usr/lib/xorg/Xorg :0 vt1 -keeptty -nolisten tcp

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
