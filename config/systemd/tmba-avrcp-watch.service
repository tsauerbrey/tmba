[Unit]
Description=TMBA Bluetooth AVRCP Metadata Watcher
After=bluetooth.service tmba-backend.service tmba-bluetooth-watch.service
Wants=bluetooth.service
Requires=tmba-backend.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/tmba-avrcp-watch.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
