from threading import Lock
from typing import Any

from tmba.core.event_bus import event_bus
from tmba.core.source_manager import source_manager
from tmba.services.mpd_service import mpd_service
from tmba.services.source_service_registry import (
    source_service_registry,
)


class PlayerService:
    """Zentraler Zustand und Steuerung des TMBA-Players."""

    def __init__(self) -> None:
        self._lock = Lock()

        self._status = "idle"
        self._volume = 50
        self._track = source_manager.default_track_for_source()

        event_bus.subscribe(
            "source.changed",
            self._handle_source_changed,
        )

        event_bus.subscribe(
            "player.status_changed",
            self._handle_player_status_changed,
        )

        event_bus.subscribe(
            "player.track_changed",
            self._handle_player_track_changed,
        )

    def _handle_source_changed(
        self,
        data: dict[str, Any],
    ) -> None:
        """Synchronisiert den Player nach einem Quellenwechsel."""

        self.sync_active_source()

    def _handle_player_status_changed(
        self,
        data: dict[str, Any],
    ) -> None:
        """Übernimmt einen Wiedergabestatus vom EventBus."""

        source = data.get("source")
        status = data.get("status")

        if not isinstance(source, str):
            raise ValueError(
                "Das Statusereignis benötigt einen Quellennamen."
            )

        if not isinstance(status, str):
            raise ValueError(
                "Das Statusereignis benötigt einen Wiedergabestatus."
            )

        normalized_source = source_manager.normalize_source(source)
        active_source = source_manager.get_active_source()

        if normalized_source != active_source:
            return

        normalized_status = status.strip().lower()

        if normalized_status not in {
            "idle",
            "playing",
            "paused",
            "stopped",
            "play",
            "pause",
            "stop",
        }:
            raise ValueError(
                f"Ungültiger Wiedergabestatus: {normalized_status}"
            )

        status_mapping = {
            "play": "playing",
            "pause": "paused",
            "stop": "stopped",
        }

        normalized_status = status_mapping.get(
            normalized_status,
            normalized_status,
        )

        with self._lock:
            self._status = normalized_status

    def _handle_player_track_changed(
        self,
        data: dict[str, Any],
    ) -> None:
        """Übernimmt Titelinformationen vom EventBus."""

        source = data.get("source")
        track = data.get("track")

        if not isinstance(source, str):
            raise ValueError(
                "Das Titelereignis benötigt einen Quellennamen."
            )

        if not isinstance(track, dict):
            raise ValueError(
                "Das Titelereignis benötigt gültige Titeldaten."
            )

        normalized_source = source_manager.normalize_source(source)
        active_source = source_manager.get_active_source()

        if normalized_source != active_source:
            return

        normalized_track = {
            "title": str(
                track.get("title") or "Unbekannter Titel"
            ),
            "artist": str(
                track.get("artist") or "Unbekannter Interpret"
            ),
            "album": str(
                track.get("album") or ""
            ),
            "cover_url": str(
                track.get("cover_url") or ""
            ),
            "duration": self._normalize_time(
                track.get("duration", 0)
            ),
            "elapsed": self._normalize_time(
                track.get("elapsed", 0)
            ),
        }

        with self._lock:
            self._track = normalized_track

    def get_status(self) -> dict[str, Any]:
        """Gibt eine vollständige Kopie des Player-Zustands zurück."""

        active_source = source_manager.get_active_source()

        with self._lock:
            return {
                "status": self._status,
                "source": active_source,
                "volume": self._volume,
                "track": self._track.copy(),
            }

    def set_volume(self, volume: int) -> dict[str, Any]:
        """Setzt die Lautstärke im Player und – falls erreichbar – im MPD."""

        normalized_volume = self._normalize_volume(volume)
        mpd_result = mpd_service.set_volume(normalized_volume)

        with self._lock:
            self._volume = self._normalize_volume(
                mpd_result.get("volume", normalized_volume)
            )

        return self.get_status()

    def select_source(self, source: str) -> dict[str, Any]:
        """Aktiviert eine Audioquelle."""

        normalized_source = source_manager.select_source(source)

        with self._lock:
            self._status = "idle"
            self._track = source_manager.default_track_for_source(
                normalized_source
            )

        return self.get_status()

    def sync_active_source(self) -> dict[str, Any]:
        """Synchronisiert den Player mit der automatisch aktiven Quelle."""

        active_source = source_manager.get_active_source()
        source_status = source_service_registry.get_status(
            active_source
        )

        if source_status is None:
            with self._lock:
                self._status = "idle"
                self._track = (
                    source_manager.default_track_for_source(
                        active_source
                    )
                )

            return self.get_status()

        status = str(
            source_status.get("status") or "idle"
        ).strip().lower()

        track = source_status.get("track")

        if not isinstance(track, dict):
            track = source_manager.default_track_for_source(
                active_source
            )

        normalized_track = {
            "title": str(
                track.get("title") or "Unbekannter Titel"
            ),
            "artist": str(
                track.get("artist") or "Unbekannter Interpret"
            ),
            "album": str(track.get("album") or ""),
            "cover_url": str(track.get("cover_url") or ""),
            "duration": self._normalize_time(
                track.get("duration", 0)
            ),
            "elapsed": self._normalize_time(
                track.get("elapsed", 0)
            ),
        }

        with self._lock:
            self._status = status
            self._track = normalized_track

        return self.get_status()

    def refresh_from_mpd(self) -> dict[str, Any]:
        """Übernimmt Wiedergabestatus und Titelinformationen vom MPD."""

        mpd_status = mpd_service.get_status()

        if not mpd_status.get("connected", False):
            return self.get_status()

        mpd_track = mpd_service.get_current_track()

        with self._lock:
            self._status = str(
                mpd_status.get("state", "stop")
            )

            self._volume = self._normalize_volume(
                mpd_status.get("volume", self._volume)
            )

            self._track = {
                "title": str(
                    mpd_track.get("title")
                    or "Unbekannter Titel"
                ),
                "artist": str(
                    mpd_track.get("artist")
                    or "Unbekannter Interpret"
                ),
                "album": str(
                    mpd_track.get("album") or ""
                ),
                "cover_url": str(
                    mpd_track.get("cover_url") or ""
                ),
                "duration": self._normalize_time(
                    mpd_track.get("duration", 0)
                ),
                "elapsed": self._normalize_time(
                    mpd_track.get("elapsed", 0)
                ),
            }

        return self.get_status()

    def play(self) -> dict[str, Any]:
        """Startet oder setzt die MPD-Wiedergabe fort."""

        mpd_result = mpd_service.play()

        if mpd_result.get("connected", False):
            return self.refresh_from_mpd()

        return self.get_status()

    def pause(self) -> dict[str, Any]:
        """Pausiert die MPD-Wiedergabe."""

        mpd_result = mpd_service.pause()

        if mpd_result.get("connected", False):
            return self.refresh_from_mpd()

        return self.get_status()

    def stop(self) -> dict[str, Any]:
        """Stoppt die MPD-Wiedergabe."""

        mpd_result = mpd_service.stop()

        if mpd_result.get("connected", False):
            return self.refresh_from_mpd()

        with self._lock:
            self._status = "idle"
            self._track = source_manager.default_track_for_source()

        return self.get_status()

    def previous(self) -> dict[str, Any]:
        """Wechselt zum vorherigen MPD-Titel."""

        mpd_result = mpd_service.previous()

        if mpd_result.get("connected", False):
            return self.refresh_from_mpd()

        return self.get_status()

    def next(self) -> dict[str, Any]:
        """Wechselt zum nächsten MPD-Titel."""

        mpd_result = mpd_service.next()

        if mpd_result.get("connected", False):
            return self.refresh_from_mpd()

        return self.get_status()

    def update_track(
        self,
        *,
        title: str,
        artist: str = "",
        album: str = "",
        cover_url: str = "",
        duration: int | float = 0,
        elapsed: int | float = 0,
    ) -> dict[str, Any]:
        """Aktualisiert die aktuell angezeigten Titelinformationen."""

        with self._lock:
            self._track = {
                "title": title,
                "artist": artist,
                "album": album,
                "cover_url": cover_url,
                "duration": self._normalize_time(duration),
                "elapsed": self._normalize_time(elapsed),
            }

        return self.get_status()

    @staticmethod
    def _normalize_volume(value: Any) -> int:
        try:
            numeric_value = int(float(value))
        except (TypeError, ValueError):
            numeric_value = 0

        return max(0, min(100, numeric_value))

    @staticmethod
    def _normalize_time(value: Any) -> int:
        try:
            numeric_value = int(float(value))
        except (TypeError, ValueError):
            numeric_value = 0

        return max(0, numeric_value)


player_service = PlayerService()