TMBA_IMAGE_NAME=tmba-developer
TMBA_IMAGE_VERSION=0.9.5
TMBA_TARGET_BOARD=raspberry-pi-4
TMBA_TARGET_ARCH=arm64
TMBA_BASE_OS=raspberry-pi-os-lite
TMBA_BASE_RELEASE=bookworm
TMBA_DEFAULT_HOSTNAME=tmba
TMBA_DEFAULT_USER=tmba
TMBA_ENABLE_SSH=1
TMBA_LOCALE=de_DE.UTF-8
TMBA_TIMEZONE=Europe/Berlin
TMBA_PI_GEN_REPOSITORY=https://github.com/RPi-Distro/pi-gen.git
TMBA_PI_GEN_REF=2026-06-18-raspios-bookworm-arm64
TMBA_PI_GEN_COMMIT=
TMBA_DEPLOY_COMPRESSION=xz
TMBA_DOCKER_PLATFORM=linux/arm64

TMBA_MIN_FREE_GIB=35
TMBA_MIN_DOCKER_MEMORY_GIB=8
TMBA_MIN_DOCKER_CPUS=4
